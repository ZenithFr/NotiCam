#version 450
layout(local_size_x = 16, local_size_y = 16) in;

// Bindings:
// 0: Metric Depth texture (R32F in meters)
// 1: Output CoC radius texture (R16_SFLOAT)

layout(binding = 0) uniform sampler2D uDepth;
layout(binding = 1, r16f) writeonly uniform image2D uOutCoc;

layout(push_constant) uniform CocPushConstants {
    uint width;               // Pass width (e.g. 720 for preview, 2040 for still)
    uint height;              // Pass height (e.g. 540 for preview, 1536 for still)
    float focalMm;            // 5.56 mm
    float fStop;              // 1.8
    float sensorWidthMm;      // 8.16 mm
    float s1_focus_m;         // Subject focus plane distance in meters
    float targetFarFieldPx;   // Target far-field blur radius in px at preview width (5-30, default 15; < 0 for physical debug)
    float previewWidth;       // Reference preview width (default 720.0)
} pc;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= pc.width || coord.y >= pc.height) {
        return;
    }

    vec2 uv = (vec2(coord) + 0.5) / vec2(pc.width, pc.height);
    float s2_depth_m = texture(uDepth, uv).r;

    float f_mm = pc.focalMm;
    float N = max(pc.fStop, 0.5);
    float S1_mm = max(pc.s1_focus_m, 0.1) * 1000.0;
    float S2_mm = max(s2_depth_m, 0.05) * 1000.0;

    // Asymptotic far-field physical CoC (S2 -> infinity, |S2 - S1|/S2 -> 1.0):
    // Aperture = f / N
    // mag = f / (S1 - f)
    // coc_diam_inf_mm = (f / N) * mag
    // coc_radius_inf_norm = 0.5 * coc_diam_inf_mm / sensorWidthMm
    float aperture_diam_mm = f_mm / N;
    float mag = f_mm / max(S1_mm - f_mm, 1.0);
    float coc_radius_inf_norm = 0.5 * (aperture_diam_mm * mag) / pc.sensorWidthMm;

    float ratio = abs(S2_mm - S1_mm) / S2_mm;
    float coc_radius_norm = 0.0;

    if (pc.targetFarFieldPx < 0.0) {
        // Physical truth debug mode: raw optical CoC as fraction of frame width
        coc_radius_norm = coc_radius_inf_norm * ratio;
    } else {
        // Normalized Target Mode: slider exposes far-field blur radius at preview width (default 15px @ 720w)
        // Internal gain = (targetFarFieldPx / previewWidth) / coc_radius_inf_norm
        // Far-field blur remains invariant as subject moves (S1 changes)
        float refWidth = (pc.previewWidth > 0.0) ? pc.previewWidth : 720.0;
        float target_radius_norm = ((pc.targetFarFieldPx > 0.0) ? pc.targetFarFieldPx : 15.0) / refWidth;
        coc_radius_norm = target_radius_norm * ratio;
    }

    // Near-field suppression: portrait bokeh is background-only.
    // Clamp foreground (S2 < S1) blur radius to 0.0 to prevent imperfect alpha from bleeding blurred foreground.
    if (s2_depth_m < pc.s1_focus_m) {
        coc_radius_norm = 0.0;
    }

    // Clamp normalized radius: max 0.042 frame width (accommodates 30.0 px slider max @ 720w preview)
    coc_radius_norm = clamp(coc_radius_norm, 0.0, 0.042);

    imageStore(uOutCoc, coord, vec4(coc_radius_norm, 0.0, 0.0, 1.0));
}
