#version 450
layout(local_size_x = 16, local_size_y = 16) in;

// Bindings:
// 0: Sampled Sharp Color / Luma texture
// 1: Sampled Low-Res Alpha Matte (256x256 soft probability from NPU)
// 2: Output Refined Alpha Matte (R8)
// 3: Metric Depth texture (R32F in meters)
// 4: SSBO for Depth Gate statistics

layout(binding = 0) uniform sampler2D uLuma;
layout(binding = 1) uniform sampler2D uAlphaIn;
layout(binding = 2, r8) writeonly uniform image2D uOutAlpha;
layout(binding = 3) uniform sampler2D uDepth;

layout(std430, binding = 4) buffer GateStats {
    uint totalCount;
    uint alphaBeforeSum;
    uint alphaAfterSum;
    uint subjectRescuedCount;
    uint bgVetoedCount;
    uint preHist[10];
    uint postHist[10];
} stats;

layout(push_constant) uniform AlphaPushConstants {
    uint width;
    uint height;
    float s1_focus_m;
    uint stubAlphaMode; // 1 = depth-derived alpha (stub), 0 = guided filter real alpha
    uint yOffset;
    uint DISABLE_GUIDED; // 1 = bypass guided filter, read pre-guided baseAlpha directly
    uint gateBypass; // 1 = bypass depth gate, 0 = depth gate active
    uint recordStats; // 1 = record gate stats, 0 = skip
    uint alphaDiag; // 1 = record subject depth discriminator, 0 = skip
} pc;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.x, gl_GlobalInvocationID.y + pc.yOffset);
    if (coord.x >= int(pc.width) || coord.y >= int(pc.height)) {
        return;
    }

    vec2 uv = (vec2(coord) + 0.5) / vec2(pc.width, pc.height);

    float s1 = max(pc.s1_focus_m, 0.1);
    float alpha = 0.0;
    if (pc.stubAlphaMode != 0) {
        // Stub-Alpha Debug Mode: derive alpha directly from depth map (no NPU)
        vec2 depthUv = vec2(uv.x, (uv.y - 0.5) * 1.1667 + 0.5);
        float depth_m = texture(uDepth, depthUv).r;
        alpha = 1.0 - smoothstep(s1 - 0.15, s1 + 0.15, depth_m);
    } else {
        // ── Real Alpha Guided Filter Edge Refinement ───────────────────────
        // 1. Bilinear sample of the 256x256 soft semantic probability matte
        float baseAlpha = texture(uAlphaIn, uv).r;

        // If DISABLE_GUIDED is active, bypass luma edge refinement and use base matte directly
        if (pc.DISABLE_GUIDED != 0) {
            alpha = baseAlpha;
        } else {
            // 2. High-resolution luma guidance
            vec4 sharpColor = texture(uLuma, uv);
            float centerLuma = dot(sharpColor.rgb, vec3(0.299, 0.587, 0.114));

            // 3. Fast 5-tap cross window for local luma mean & variance
            vec2 texel = 1.0 / vec2(pc.width, pc.height);
            float lumaT = dot(texture(uLuma, uv + vec2(0.0, -texel.y)).rgb, vec3(0.299, 0.587, 0.114));
            float lumaB = dot(texture(uLuma, uv + vec2(0.0,  texel.y)).rgb, vec3(0.299, 0.587, 0.114));
            float lumaL = dot(texture(uLuma, uv + vec2(-texel.x, 0.0)).rgb, vec3(0.299, 0.587, 0.114));
            float lumaR = dot(texture(uLuma, uv + vec2( texel.x, 0.0)).rgb, vec3(0.299, 0.587, 0.114));

            float meanLuma = (centerLuma + lumaT + lumaB + lumaL + lumaR) * 0.2;
            float diff = centerLuma - meanLuma;

            // Near soft segmentation boundaries (baseAlpha in [0.08, 0.92]), refine edges with luma contrast
            float edgeGate = smoothstep(0.0, 0.35, baseAlpha) * (1.0 - smoothstep(0.65, 1.0, baseAlpha));
            float refined = baseAlpha + diff * 1.2 * edgeGate;

            alpha = clamp(refined, 0.0, 1.0);
        }
    }

    if (pc.stubAlphaMode == 0) {
        // Lift-only low-light recovery (unchanged)
        float lift = max(0.0, (alpha - 0.5) * 2.0);
        alpha = clamp(alpha + (1.0 - alpha) * lift * lift, 0.0, 1.0);

        float alphaPreFusion = alpha;

        if (pc.gateBypass == 0) {
            // --- Depth-primary mask fusion ---
            // Depth becomes the tie-breaker on subject/background.
            // Rescue: inside s1, force sharp (low-light AI confidence collapse).
            // Veto:   beyond 1.5*s1, kill AI over-claim (blur bleed, wires).
            vec2 depthUv = vec2(uv.x, (uv.y - 0.5) * 1.1667 + 0.5);
            float d = texture(uDepth, depthUv).r;

            // y8=0 -> 0.0m and y8=255 -> ~10.0m both mean "no measurement".
            float validDepth = step(0.05, d) * step(d, 9.95);

            float rescue = (1.0 - smoothstep(s1 * 0.9, s1 * 1.5, d))
                         * validDepth
                         * smoothstep(0.30, 0.80, alpha);
            alpha = max(alpha, rescue);

            float veto = smoothstep(s1 * 1.5, s1 * 3.0, d) * validDepth;
            alpha = alpha * (1.0 - veto);
        }

        if (pc.recordStats != 0) {
            atomicAdd(stats.totalCount, 1);
            atomicAdd(stats.alphaBeforeSum, uint(alphaPreFusion * 1000.0));
            atomicAdd(stats.alphaAfterSum, uint(alpha * 1000.0));

            if (alpha > alphaPreFusion + 0.001) {
                atomicAdd(stats.subjectRescuedCount, 1);
            } else if (alpha < alphaPreFusion - 0.001) {
                atomicAdd(stats.bgVetoedCount, 1);
            }

            int bPre = clamp(int(alphaPreFusion * 10.0), 0, 9);
            atomicAdd(stats.preHist[bPre], 1);
            int bPost = clamp(int(alpha * 10.0), 0, 9);
            atomicAdd(stats.postHist[bPost], 1);
        }
    }

    imageStore(uOutAlpha, coord, vec4(alpha, 0.0, 0.0, 1.0));
}
