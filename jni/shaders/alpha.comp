#version 450
layout(local_size_x = 16, local_size_y = 16) in;

// Bindings:
// 0: Sampled Sharp Color / Luma texture
// 1: Sampled Low-Res Alpha Matte (256x256 soft probability from NPU)
// 2: Output Refined Alpha Matte (R8)
// 3: Metric Depth texture (R32F in meters)
// 4: SSBO for Depth Gate statistics

layout(binding = 0) uniform sampler2D uLuma;
layout(binding = 1) uniform sampler2D uAlphaIn;
layout(binding = 2, r8) writeonly uniform image2D uOutAlpha;
layout(binding = 3) uniform sampler2D uDepth;

layout(std430, binding = 4) buffer GateStats {
    uint totalCount;
    uint alphaBeforeSum;
    uint alphaAfterSum;
    uint subjectRescuedCount;
    uint bgVetoedCount;
    uint preHist[10];
    uint postHist[10];
} stats;

layout(push_constant) uniform AlphaPushConstants {
    uint width;
    uint height;
    float s1_focus_m;
    uint stubAlphaMode; // 1 = depth-derived alpha (stub), 0 = guided filter real alpha
    uint yOffset;
    uint DISABLE_GUIDED; // 1 = bypass guided filter, read pre-guided baseAlpha directly
    uint gateBypass; // 1 = bypass depth gate, 0 = depth gate active
    uint recordStats; // 1 = record gate stats, 0 = skip
    uint alphaDiag; // 1 = record subject depth discriminator, 0 = skip
    uint edgeRefine; // 0 = off, 1 = bilateral only, 2 = bilateral + contrast, 3 = contrast only
    uint depthW;
    uint depthH;
} pc;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.x, gl_GlobalInvocationID.y + pc.yOffset);
    if (coord.x >= int(pc.width) || coord.y >= int(pc.height)) {
        return;
    }

    vec2 uv = (vec2(coord) + 0.5) / vec2(pc.width, pc.height);

    float s1 = max(pc.s1_focus_m, 0.1);
    float alpha = 0.0;
    if (pc.stubAlphaMode != 0) {
        // Stub-Alpha Debug Mode: derive alpha directly from depth map (no NPU)
        vec2 depthUv = uv; // Staging already aligned disparity to color; no second crop.
        float depth_m = texture(uDepth, depthUv).r;
        float valid = step(0.05, depth_m) * step(depth_m, 9.95);
        alpha = (1.0 - smoothstep(max(s1 * 1.02, 0.1), max(s1 * 1.15, max(s1 * 1.02, 0.1) + 0.05), depth_m)) * valid;
    } else {
        // ── Real Alpha Guided Filter Edge Refinement ───────────────────────
        // 1. Bilinear sample of the 256x256 soft semantic probability matte
        float baseAlpha = texture(uAlphaIn, uv).r;

        // If DISABLE_GUIDED is active, bypass luma edge refinement and use base matte directly
        if (pc.DISABLE_GUIDED != 0) {
            alpha = baseAlpha;
        } else {
            // Joint bilateral upsampling at the SEMANTIC texel footprint.
            // Brightness alone must not add/subtract foreground probability.
            vec3 centerColor = texture(uLuma, uv).rgb;
            vec2 semanticStep = 1.0 / vec2(256.0, 256.0);
            float sum = 0.0;
            float weights = 0.0;
            for (int y = -1; y <= 1; ++y) {
                for (int x = -1; x <= 1; ++x) {
                    vec2 q = clamp(uv + vec2(x, y) * semanticStep, vec2(0.0), vec2(1.0));
                    vec3 delta = texture(uLuma, q).rgb - centerColor;
                    float spatial = exp(-float(x*x + y*y) * 0.5);
                    float range = exp(-dot(delta, delta) / (2.0 * 0.10 * 0.10));
                    float weight = spatial * range;
                    sum += texture(uAlphaIn, q).r * weight;
                    weights += weight;
                }
            }
            alpha = clamp(sum / max(weights, 0.00001), 0.0, 1.0);
        }
    }

    if (pc.stubAlphaMode == 0) {
        vec2 depthUv = uv; // Staging already aligned disparity to color; no second crop.

        // --- Edge refinement: joint bilateral in transition band ---
        if ((pc.edgeRefine == 1 || pc.edgeRefine == 2) && alpha > 0.02 && alpha < 0.98) {
            vec2 texel = 1.0 / vec2(pc.width, pc.height);
            vec2 dtexel = 1.0 / vec2(pc.depthW, pc.depthH);

            float dC = texture(uDepth, depthUv).r;
            float lC = dot(texture(uLuma, uv).rgb, vec3(0.299, 0.587, 0.114));

            // sigma_d scales with focus distance so the filter adapts to framing.
            float sigmaD = max(0.05, s1 * 0.10);
            float sigmaL = 0.08;
            float sigmaS = 1.5;

            float wsum = 0.0;
            float asum = 0.0;

            for (int dy = -2; dy <= 2; ++dy) {
                for (int dx = -2; dx <= 2; ++dx) {
                    vec2 q = uv + vec2(dx, dy) * (texel * 2.0 / 2.0);
                    float ws = exp(-float(dx*dx + dy*dy) / (2.0*sigmaS*sigmaS));

                    float aQ = texture(uAlphaIn, q).r;
                    float lQ = dot(texture(uLuma, q).rgb, vec3(0.299,0.587,0.114));
                    float dQ = texture(uDepth, q).r;

                    float wl = exp(-(lQ - lC)*(lQ - lC) / (2.0*sigmaL*sigmaL));

                    // Invalid depth (0 or ~10m) -> neutral weight, fall back to luma.
                    float dValid = step(0.05, dQ) * step(dQ, 9.95)
                                 * step(0.05, dC) * step(dC, 9.95);
                    float wd = mix(1.0, exp(-(dQ - dC)*(dQ - dC) /
                                          (2.0*sigmaD*sigmaD)), dValid);

                    float w = ws * wl * wd;
                    wsum += w;
                    asum += w * aQ;
                }
            }
            if (wsum > 1e-5) alpha = asum / wsum;
        }

        float alphaPreFusion = alpha;

        if (pc.gateBypass == 0) {
            // --- Depth-primary mask fusion ---
            // Depth becomes the tie-breaker on subject/background.
            // Rescue: inside s1, force sharp (low-light AI confidence collapse).
            // Veto:   beyond 1.5*s1, kill AI over-claim (blur bleed, wires).
            float d = texture(uDepth, depthUv).r;

            // y8=0 -> 0.0m and y8=255 -> ~10.0m both mean "no measurement".
            float validDepth = step(0.05, d) * step(d, 9.95);

            // A measured foreground object/hand need not be a recognized person.
            // Unknown depth is neutral, never promoted to a synthetic subject.
            float nearEnd = max(s1 * 1.15, max(s1 * 1.02, 0.1) + 0.05);
            float rescue = (1.0 - smoothstep(max(s1 * 1.02, 0.1), nearEnd, d)) * validDepth;
            alpha = max(alpha, rescue);

            float veto = smoothstep(s1 * 1.5, s1 * 3.0, d) * validDepth;
            alpha = alpha * (1.0 - veto);
        }

        // --- Contrast narrowing: symmetric around true boundary ---
        if (pc.edgeRefine == 2 || pc.edgeRefine == 3) {
            alpha = clamp((alpha - 0.5) * 2.0 + 0.5, 0.0, 1.0);
        }

        if (pc.recordStats != 0) {
            atomicAdd(stats.totalCount, 1);
            atomicAdd(stats.alphaBeforeSum, uint(alphaPreFusion * 1000.0));
            atomicAdd(stats.alphaAfterSum, uint(alpha * 1000.0));

            if (alpha > alphaPreFusion + 0.001) {
                atomicAdd(stats.subjectRescuedCount, 1);
            } else if (alpha < alphaPreFusion - 0.001) {
                atomicAdd(stats.bgVetoedCount, 1);
            }

            int bPre = clamp(int(alphaPreFusion * 10.0), 0, 9);
            atomicAdd(stats.preHist[bPre], 1);
            int bPost = clamp(int(alpha * 10.0), 0, 9);
            atomicAdd(stats.postHist[bPost], 1);
        }
    }

    imageStore(uOutAlpha, coord, vec4(alpha, 0.0, 0.0, 1.0));
}
