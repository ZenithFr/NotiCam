<?xml version="1.0" encoding="utf-8"?>
<!-- NotiCam · Apple Camera spacing & sizing scale (8pt grid) -->
<resources>

    <!-- Horizontal page gutters -->
    <dimen name="ios_gutter">16dp</dimen>
    <dimen name="ios_gutter_wide">24dp</dimen>

    <!-- Camera chrome -->
    <dimen name="ios_control_size">36dp</dimen>       <!-- glass circle buttons -->
    <dimen name="ios_control_icon">20dp</dimen>
    <dimen name="ios_control_touch">44dp</dimen>      <!-- minimum touch target -->
    <dimen name="ios_capsule_height">34dp</dimen>
    <dimen name="ios_capsule_radius">17dp</dimen>
    <dimen name="ios_panel_radius">24dp</dimen>

    <!-- Shutter -->
    <dimen name="ios_shutter_size">72dp</dimen>
    <dimen name="ios_shutter_ring_width">4dp</dimen>
    <dimen name="ios_shutter_gap">3.5dp</dimen>
    <dimen name="ios_gallery_size">52dp</dimen>

    <!-- Type -->
    <dimen name="ios_text_mode">12sp</dimen>
    <dimen name="ios_text_label">13sp</dimen>
    <dimen name="ios_text_caption">11sp</dimen>
    <dimen name="ios_text_micro">10sp</dimen>

    <!-- Vertical rhythm -->
    <dimen name="ios_gap_xs">6dp</dimen>
    <dimen name="ios_gap_s">10dp</dimen>
    <dimen name="ios_gap_m">16dp</dimen>
    <dimen name="ios_gap_l">24dp</dimen>

</resources>
