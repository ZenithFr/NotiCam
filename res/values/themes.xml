<?xml version="1.0" encoding="utf-8"?>
<!--
  Window theme only. Everything visual lives in Compose
  (com.zenith.auxcam.ui.theme); this just makes the window itself black and
  edge-to-edge before the first frame, so there is no white flash on launch.
-->
<resources>
    <style name="Theme.NotiCam" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
