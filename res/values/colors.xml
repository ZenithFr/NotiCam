<?xml version="1.0" encoding="utf-8"?>
<!--
  NotiCam · Apple Camera design tokens
  Values are taken from iOS system colours (dark appearance) so the camera chrome
  reads exactly like the iPhone Camera / Portrait UI.
-->
<resources>

    <!-- Surfaces -->
    <color name="ios_black">#FF000000</color>
    <color name="ios_surface_glass">#8C1C1C1E</color>        <!-- 55% #1C1C1E -->
    <color name="ios_surface_glass_strong">#E6141416</color> <!-- 90% near-black glass -->
    <color name="ios_surface_glass_panel">#F21C1C1E</color>  <!-- bottom sheet glass -->
    <color name="ios_surface_glass_pressed">#33FFFFFF</color>

    <!-- Labels -->
    <color name="ios_label">#FFFFFFFF</color>
    <color name="ios_label_secondary">#A6FFFFFF</color>   <!-- 65% -->
    <color name="ios_label_tertiary">#66FFFFFF</color>    <!-- 40% -->
    <color name="ios_label_quaternary">#40FFFFFF</color>  <!-- 25% -->
    <color name="ios_label_on_white">#FF000000</color>

    <!-- Separators / strokes -->
    <color name="ios_separator">#1FFFFFFF</color>         <!-- 12% -->
    <color name="ios_separator_strong">#33FFFFFF</color>  <!-- 20% -->

    <!-- Accents -->
    <color name="ios_yellow">#FFFFD60A</color>            <!-- iOS systemYellow (dark) -->
    <color name="ios_yellow_dim">#99FFD60A</color>
    <color name="ios_red">#FFFF453A</color>               <!-- iOS systemRed (dark) -->
    <color name="ios_green">#FF30D158</color>             <!-- iOS systemGreen (dark) -->
    <color name="ios_white">#FFFFFFFF</color>
    <color name="ios_white_90">#E6FFFFFF</color>
    <color name="ios_scrim">#66000000</color>

    <!-- Track / fill -->
    <color name="ios_slider_track">#3DFFFFFF</color>
    <color name="ios_slider_fill">#FFFFFFFF</color>

</resources>
