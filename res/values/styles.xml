<?xml version="1.0" encoding="utf-8"?>
<!--
  NotiCam · Typography
  iOS camera chrome is all SF Pro: 12pt semibold uppercase mode names, 13pt
  regular labels, 10–11pt captions with generous tracking.
-->
<resources>

    <!-- Base token root -->
    <style name="Ios" />

    <!-- Base: upright, white, system sans -->
    <style name="Ios.Text">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/ios_label</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineSpacingMultiplier">1.05</item>
    </style>

    <!-- Big mode names in the carousel: VIDEO · PHOTO · PORTRAIT -->
    <style name="Ios.Text.Mode">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/ios_text_mode</item>
        <item name="android:letterSpacing">0.075</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
    </style>

    <!-- Lens / zoom chips: 1× · 2× · 5× -->
    <style name="Ios.Text.Lens">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- Small caps section header inside sheets -->
    <style name="Ios.Text.Section">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/ios_text_caption</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/ios_label_tertiary</item>
    </style>

    <!-- Row value on the right side of a settings row -->
    <style name="Ios.Text.Value">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/ios_text_label</item>
        <item name="android:textColor">@color/ios_label</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- Micro caption (status line, telemetry) -->
    <style name="Ios.Text.Caption">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">@dimen/ios_text_caption</item>
        <item name="android:textColor">@color/ios_label_tertiary</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="Ios.Text.Telemetry">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">@dimen/ios_text_micro</item>
        <item name="android:textColor">@color/ios_label_tertiary</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- Glass circle icon button (flash / pro drawer / lens flip) -->
    <style name="Ios.IconButton">
        <item name="android:layout_width">@dimen/ios_control_touch</item>
        <item name="android:layout_height">@dimen/ios_control_touch</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">@drawable/ios_circle_ripple</item>
        <item name="android:cropToPadding">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Pill button used inside the pro sheet -->
    <style name="Ios.Pill">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/ios_label</item>
        <item name="android:background">@drawable/ios_capsule_ripple</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

</resources>
