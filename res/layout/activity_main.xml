<?xml version="1.0" encoding="utf-8"?>
<!--
  NotiCam · Apple Camera-style viewfinder chrome (iOS 18/26 language)

  Composition (vertical, spacer absorbs the letterbox under the 4:3 sensor view)
  ────────────────────────────────────────────────────────────────────────────
  ┌──────────────────────────────────────────┐
  │ (flash)         status pill        (pro) │  ← floats over the viewfinder
  │                                          │
  │              4:3 VIEWFINDER              │
  │           (Vulkan bokeh present)         │
  │                                          │
  │              1×   2×   5×                │  ← lens chips, hugging the frame
  │        ƒ ───────●──────────────  1.8     │  ← Portrait-only quick aperture
  │                                          │
  │            PRO SHEET (slide-up)          │
  │          PHOTO  PORTRAIT  PRO            │  ← systemYellow selection
  │        (gallery)   ◉    (lens switch)    │
  └──────────────────────────────────────────┘
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ios_black">

    <!-- ══════════════════════════ CAMERA COLUMN ══════════════════════════ -->
    <LinearLayout
        android:id="@+id/camera_column"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ─────────────── 1. VIEWFINDER ─────────────── -->
        <FrameLayout
            android:id="@+id/viewfinder_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:clickable="true"
            android:focusable="false">

            <com.zenith.auxcam.AutoFitSurfaceView
                android:id="@+id/surface_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center" />

            <!-- Focus reticle + rule-of-thirds grid -->
            <com.zenith.auxcam.FocusOverlayView
                android:id="@+id/focus_overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Shutter bloom, confined to the scene -->
            <View
                android:id="@+id/capture_flash"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/ios_white"
                android:alpha="0"
                android:clickable="false"
                android:focusable="false" />
        </FrameLayout>

        <!-- ─────────────── 2. LENS CHIPS ─────────────── -->
        <LinearLayout
            android:id="@+id/zoom_row"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="14dp">

            <TextView
                android:id="@+id/btn_zoom_1"
                style="@style/Ios.Text.Lens"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/ios_circle_white_ripple"
                android:text="@string/lens_1x"
                android:textColor="@color/ios_label_on_white" />

            <TextView
                android:id="@+id/btn_zoom_2"
                style="@style/Ios.Text.Lens"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/ios_circle_ripple"
                android:text="@string/lens_2x"
                android:textColor="@color/ios_label" />

            <TextView
                android:id="@+id/btn_zoom_5"
                style="@style/Ios.Text.Lens"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/ios_circle_ripple"
                android:text="@string/lens_5x"
                android:textColor="@color/ios_label" />
        </LinearLayout>

        <!-- ─────────── 3. PORTRAIT QUICK APERTURE ─────────── -->
        <LinearLayout
            android:id="@+id/row_aperture_quick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="@dimen/ios_gutter_wide"
            android:paddingRight="@dimen/ios_gutter_wide"
            android:layout_marginTop="2dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/ic_aperture"
                android:alpha="0.7"
                android:layout_marginEnd="6dp"
                android:contentDescription="@string/aperture" />

            <SeekBar
                android:id="@+id/sb_aperture_quick"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:max="21"
                android:progress="2"
                android:maxHeight="4dp"
                android:minHeight="4dp"
                android:splitTrack="false"
                android:progressDrawable="@drawable/ios_slider_track"
                android:thumb="@drawable/ios_slider_thumb" />

            <TextView
                android:id="@+id/tv_aperture_quick"
                style="@style/Ios.Text.Value"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="ƒ 1.8" />
        </LinearLayout>

        <!-- Absorbs the letterbox between the 4:3 sensor view and the toolbar -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- ─────────────── 4. BOTTOM CHROME ─────────────── -->
        <LinearLayout
            android:id="@+id/bottom_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/ios_toolbar_scrim"
            android:paddingLeft="@dimen/ios_gutter_wide"
            android:paddingRight="@dimen/ios_gutter_wide"
            android:paddingTop="18dp"
            android:paddingBottom="10dp">

            <!-- ───── PRO SHEET (expands the toolbar upward) ───── -->
            <LinearLayout
                android:id="@+id/drawer_pro_controls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/ios_card_glass"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:paddingTop="14dp"
                android:paddingBottom="16dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone">

                <!-- Sheet header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        style="@style/Ios.Text.Section"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/pro_controls" />

                    <TextView
                        android:id="@+id/btn_pro_done"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:gravity="center"
                        android:paddingLeft="12dp"
                        android:paddingRight="2dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:text="@string/sheet_done"
                        android:textColor="@color/ios_yellow"
                        android:textSize="@dimen/ios_text_label"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>

                <!-- Aperture: drives the physical CoC of the bokeh engine -->
                <LinearLayout
                    android:id="@+id/row_aperture"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_aperture"
                            android:alpha="0.75"
                            android:layout_marginEnd="7dp"
                            android:contentDescription="@string/aperture" />

                        <TextView
                            style="@style/Ios.Text.Section"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/aperture" />

                        <TextView
                            android:id="@+id/tv_aperture_value"
                            style="@style/Ios.Text.Value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ƒ 1.8" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/sb_aperture"
                        android:layout_width="match_parent"
                        android:layout_height="34dp"
                        android:max="21"
                        android:progress="2"
                        android:maxHeight="4dp"
                        android:minHeight="4dp"
                        android:splitTrack="false"
                        android:progressDrawable="@drawable/ios_slider_track"
                        android:thumb="@drawable/ios_slider_thumb" />

                    <!-- Aperture ladder labels, like the iPhone Portrait dial -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="0dp"
                        android:layout_marginBottom="8dp">

                        <TextView style="@style/Ios.Text.Caption" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="1.4" android:textSize="9sp" />
                        <TextView style="@style/Ios.Text.Caption" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="2.5"
                            android:textSize="9sp" />
                        <TextView style="@style/Ios.Text.Caption" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1"
                            android:gravity="center" android:text="4.5" android:textSize="9sp" />
                        <TextView style="@style/Ios.Text.Caption" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="8"
                            android:textSize="9sp" />
                        <TextView style="@style/Ios.Text.Caption" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1"
                            android:gravity="end" android:text="16" android:textSize="9sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Exposure compensation -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            style="@style/Ios.Text.Section"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/exposure_compensation" />

                        <TextView
                            android:id="@+id/tv_ev_label"
                            style="@style/Ios.Text.Value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 EV" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/sb_ev"
                        android:layout_width="match_parent"
                        android:layout_height="34dp"
                        android:max="24"
                        android:progress="12"
                        android:maxHeight="4dp"
                        android:minHeight="4dp"
                        android:splitTrack="false"
                        android:progressDrawable="@drawable/ios_slider_track"
                        android:thumb="@drawable/ios_slider_thumb" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@drawable/ios_divider"
                    android:layout_marginBottom="12dp" />

                <!-- Grid · RAW · Timer -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <Button
                        android:id="@+id/btn_grid"
                        style="@style/Ios.Pill"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:text="@string/grid"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btn_raw"
                        style="@style/Ios.Pill"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:text="@string/raw"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btn_hq"
                        style="@style/Ios.Pill"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:text="@string/timer" />
                </LinearLayout>

                <!-- Live engine telemetry -->
                <TextView
                    android:id="@+id/tv_telemetry"
                    style="@style/Ios.Text.Telemetry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:text="VIEWFINDER · idle" />
            </LinearLayout>

            <!-- ───── MODE CAROUSEL ───── -->
            <LinearLayout
                android:id="@+id/mode_carousel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/mode_photo"
                    style="@style/Ios.Text.Mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mode_photo"
                    android:textColor="@color/ios_yellow" />

                <TextView
                    android:id="@+id/mode_portrait"
                    style="@style/Ios.Text.Mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mode_portrait"
                    android:textColor="@color/ios_label_tertiary" />

                <TextView
                    android:id="@+id/mode_hq"
                    style="@style/Ios.Text.Mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mode_hq"
                    android:textColor="@color/ios_label_tertiary" />
            </LinearLayout>

            <!-- ───── SHUTTER ROW ───── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="10dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp">

                <!-- Gallery thumbnail: shows the real captured bokeh frame -->
                <FrameLayout
                    android:id="@+id/gallery_button"
                    android:layout_width="@dimen/ios_gallery_size"
                    android:layout_height="@dimen/ios_gallery_size"
                    android:background="@drawable/ios_gallery_thumb"
                    android:clipToOutline="true"
                    android:contentDescription="@string/gallery">

                    <ImageView
                        android:id="@+id/iv_gallery_thumb"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="@string/gallery" />

                    <ImageView
                        android:id="@+id/iv_gallery_placeholder"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_gallery_placeholder"
                        android:contentDescription="@string/gallery" />
                </FrameLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Apple shutter: ring + disc, compresses on press -->
                <com.zenith.auxcam.ShutterButton
                    android:id="@+id/btn_shutter"
                    android:layout_width="@dimen/ios_shutter_size"
                    android:layout_height="@dimen/ios_shutter_size"
                    android:contentDescription="@string/shutter" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/btn_switch_cam"
                    style="@style/Ios.IconButton"
                    android:layout_width="@dimen/ios_control_touch"
                    android:layout_height="@dimen/ios_control_touch"
                    android:src="@drawable/ic_camera_flip"
                    android:contentDescription="@string/switch_lens" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ══════════════════════════ TOP BAR ══════════════════════════ -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="@dimen/ios_gutter"
        android:paddingRight="@dimen/ios_gutter"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <!-- Flash: off → auto → on -->
        <ImageButton
            android:id="@+id/btn_flash"
            style="@style/Ios.IconButton"
            android:layout_width="@dimen/ios_control_touch"
            android:layout_height="@dimen/ios_control_touch"
            android:src="@drawable/ic_flash_off"
            android:contentDescription="@string/flash_off" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Engine status (Shizuku / session state) -->
        <TextView
            android:id="@+id/tv_status"
            style="@style/Ios.Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="216dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:background="@drawable/ios_status_pill"
            android:text="@string/status_connecting"
            android:textColor="@color/ios_label_secondary" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Pro controls sheet toggle -->
        <ImageButton
            android:id="@+id/btn_pro"
            style="@style/Ios.IconButton"
            android:layout_width="@dimen/ios_control_touch"
            android:layout_height="@dimen/ios_control_touch"
            android:src="@drawable/ic_sliders"
            android:contentDescription="@string/pro_controls" />
    </LinearLayout>

    <!-- ══════════════════════ TRANSIENT OVERLAYS ══════════════════════ -->

    <!-- Flying thumbnail on capture (gallery hand-off) -->
    <ImageView
        android:id="@+id/iv_capture_flyer"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:scaleType="centerCrop"
        android:visibility="invisible"
        android:elevation="8dp" />

    <!-- Orbiting zoom dial (pinch / drag) -->
    <com.zenith.auxcam.ZoomDialView
        android:id="@+id/zoom_dial"
        android:layout_width="236dp"
        android:layout_height="236dp"
        android:layout_gravity="center"
        android:visibility="invisible"
        android:elevation="12dp" />

</FrameLayout>
