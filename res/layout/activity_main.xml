<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 1. Central Native 4:3 Viewfinder Viewport -->
    <FrameLayout
        android:id="@+id/viewfinder_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="88dp">

        <com.zenith.auxcam.AutoFitSurfaceView
            android:id="@+id/surface_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />

        <com.zenith.auxcam.FocusOverlayView
            android:id="@+id/focus_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- 2. Nothing OS 5 Top Bar (Frosted Glass Acrylic Pills & Controls) -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="top"
        android:layout_marginTop="0dp"
        android:paddingTop="28dp"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingEnd="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Flash Toggle (Vector Drawable) -->
        <ImageButton
            android:id="@+id/btn_flash"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_flash_off"
            android:background="@drawable/nothing_icon_btn_bg"
            android:contentDescription="Flash Toggle"
            android:layout_marginEnd="8dp" />

        <!-- EIS Steady Mode Toggle (Action / Super EIS Mode) -->
        <Button
            android:id="@+id/btn_eis"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="EIS"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/nothing_pill_bg"
            android:layout_marginEnd="8dp" />

        <!-- 2x Optical Telephoto Quick Toggle (Camera 3 7.10mm Glass) -->
        <Button
            android:id="@+id/btn_tele_toggle"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="TELE"
            android:textColor="#99FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/nothing_pill_bg"
            android:layout_marginEnd="8dp" />

        <!-- Pro Controls Chevron Drawer Toggle (Vector Drawable) -->
        <ImageButton
            android:id="@+id/btn_drawer"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="9dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_chevron_down"
            android:background="@drawable/nothing_icon_btn_bg"
            android:contentDescription="Pro Controls Drawer"
            android:layout_marginEnd="8dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Aspect Ratio Pill (4:3 Native Sensor) -->
        <Button
            android:id="@+id/btn_aspect"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="4:3"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/nothing_pill_bg"
            android:layout_marginEnd="8dp" />

        <!-- RAW Sensor Output Pill -->
        <Button
            android:id="@+id/btn_raw"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="RAW"
            android:textColor="#000000"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/nothing_pill_active" />

    </LinearLayout>

    <!-- 3. Nothing OS 5 Pro Quick Drawer (Frosted Matte Glass Card) -->
    <LinearLayout
        android:id="@+id/drawer_pro_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="88dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:background="@drawable/nothing_glass_card"
        android:padding="16dp"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Title & Status with Nothing Red Accent Dot -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="●"
                android:textColor="#FF2A2A"
                android:textSize="10sp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="NOTICAM PRO"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ready"
                android:textColor="#88FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Horizontal Minimalist EV Dial / Slider -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EV"
                android:textColor="#B3FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginEnd="10dp" />

            <SeekBar
                android:id="@+id/sb_ev"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="24"
                android:progress="12"
                android:maxHeight="3dp"
                android:minHeight="3dp"
                android:splitTrack="false"
                android:progressDrawable="@drawable/nothing_seekbar_track"
                android:thumb="@drawable/nothing_seekbar_thumb" />

            <TextView
                android:id="@+id/tv_ev_label"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:text="0.0 EV"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="end" />
        </LinearLayout>

        <!-- Manual Shutter & ISO Frosted Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btn_shutter_speed"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="S: Auto"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/nothing_pill_bg"
                android:layout_marginEnd="10dp" />

            <Button
                android:id="@+id/btn_iso"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="ISO: Auto"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/nothing_pill_bg" />
        </LinearLayout>

    </LinearLayout>

    <!-- 4. Nothing OS 5 Bottom Controls & Chrome (Frosted Acrylic Dark Glass) -->
    <LinearLayout
        android:id="@+id/bottom_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingBottom="24dp"
        android:background="#D00B0B0E">

        <!-- Nothing Floating Zoom Indicator Badge -->
        <TextView
            android:id="@+id/tv_zoom_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/nothing_pill_bg"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="1.0x"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="12dp" />

        <!-- Nothing Circular Lens Selector Pills (.6 | 1x | 2 | SAT) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btn_uw"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text=".6"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/nothing_lens_pill_normal"
                android:layout_marginEnd="12dp" />

            <Button
                android:id="@+id/btn_wide"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="1x"
                android:textColor="#000000"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/nothing_lens_pill_selected"
                android:layout_marginEnd="12dp" />

            <Button
                android:id="@+id/btn_tele"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="2"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/nothing_lens_pill_normal"
                android:layout_marginEnd="12dp" />

            <Button
                android:id="@+id/btn_sat"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="SAT"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/nothing_lens_pill_normal" />
        </LinearLayout>

        <!-- Nothing Mode Carousel (PHOTO | 50M PRO | VIDEO | PORTRAIT) -->
        <LinearLayout
            android:id="@+id/mode_carousel"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/mode_photo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PHOTO"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:paddingLeft="14dp"
                android:paddingRight="14dp" />

            <TextView
                android:id="@+id/mode_pro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="50M PRO"
                android:textColor="#66FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:paddingLeft="14dp"
                android:paddingRight="14dp" />

            <TextView
                android:id="@+id/mode_video"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VIDEO"
                android:textColor="#66FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:paddingLeft="14dp"
                android:paddingRight="14dp" />

            <TextView
                android:id="@+id/mode_portrait"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PORTRAIT"
                android:textColor="#66FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:paddingLeft="14dp"
                android:paddingRight="14dp" />
        </LinearLayout>

        <!-- Bottom Shutter Row (Gallery Thumbnail | Nothing Shutter | Camera Switch) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="28dp"
            android:paddingRight="28dp">

            <!-- Gallery Thumbnail Preview (Last Captured Photo) -->
            <ImageView
                android:id="@+id/iv_gallery_thumb"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/gallery_thumb_bg"
                android:scaleType="centerCrop"
                android:contentDescription="Gallery" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Nothing OS Concentric Shutter Button -->
            <Button
                android:id="@+id/btn_shutter"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:background="@drawable/nothing_shutter_photo" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Camera Switch / Flip Button (Crisp Vector Icon - No Emoji) -->
            <ImageButton
                android:id="@+id/btn_switch_cam"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_camera_flip"
                android:background="@drawable/nothing_icon_btn_bg"
                android:contentDescription="Switch Camera" />

        </LinearLayout>

    </LinearLayout>

    <!-- 5. Capture Flyer overlay for flying-thumbnail animation -->
    <ImageView
        android:id="@+id/iv_capture_flyer"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="center"
        android:scaleType="centerCrop"
        android:visibility="invisible"
        android:elevation="10dp" />

    <!-- 6. Casino-Chip Radial Zoom Dial View Overlay -->
    <com.zenith.auxcam.ZoomDialView
        android:id="@+id/zoom_dial"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_gravity="center"
        android:visibility="invisible"
        android:elevation="12dp" />

</FrameLayout>
