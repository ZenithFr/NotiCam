<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Ring -->
    <item>
        <shape android:shape="oval">
            <stroke android:width="3.5dp" android:color="#FFFFFFFF" />
            <solid android:color="#00000000" />
            <size android:width="76dp" android:height="76dp" />
        </shape>
    </item>
    <!-- Inner Recording Red Solid Circle -->
    <item
        android:top="10dp"
        android:bottom="10dp"
        android:left="10dp"
        android:right="10dp">
        <shape android:shape="oval">
            <solid android:color="#FFFF2A2A" />
        </shape>
    </item>
</layer-list>
